<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Shortcut Lens</string>
    <key>CFBundleDisplayName</key>
    <string>Shortcut Lens</string>
    <key>CFBundleIdentifier</key>
    <string>com.anasaqeel.ShortcutLens</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleExecutable</key>
    <string>ShortcutLens</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>
    <!-- Agent app: no Dock icon, no app menu bar. Matches
         NSApplication.setActivationPolicy(.accessory) in ShortcutLensApp.swift. -->
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>
    <!-- No usage-description keys for camera/mic/location/network are
         declared because this app never requests any of those. Accessibility
         permission is granted via System Settings, not an Info.plist key. -->
</dict>
</plist>
